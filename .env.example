# Turso (create a NEW database for this app: turso db create mcs-studio-control)
TURSO_DATABASE_URL=libsql://mcs-studio-control-yourhandle.turso.io
TURSO_AUTH_TOKEN=

# Owner login. Pick a long passphrase.
OWNER_PASSWORD=
# 32+ random characters: openssl rand -base64 48
SESSION_SECRET=

# One token per studio agent: openssl rand -hex 32  (use a different one for each)
AGENT_TOKEN_A=
AGENT_TOKEN_B=
