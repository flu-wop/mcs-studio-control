# Which studio this Mac is: A or B
STUDIO=A

# Where the dashboard lives (no trailing slash)
APP_URL=https://studio.midcitysound.com

# The token for THIS studio, same value as AGENT_TOKEN_A or AGENT_TOKEN_B in Vercel
AGENT_TOKEN=

# OBS WebSocket (OBS > Tools > WebSocket Server Settings)
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=

# Cameras this Mac can show, as  id=OBS source name  (ids: cam1 A Room, cam2 Booth, cam3 B Room)
# Studio A:  CAMERAS=cam1=CAM A Room,cam2=CAM Booth
# Studio B:  CAMERAS=cam3=CAM B Room
CAMERAS=cam1=CAM A Room,cam2=CAM Booth

# Mics to meter and mute, as  OBS input name=Label  (names can't contain commas)
# Studio A:  MIC_INPUTS=Booth Mic=Booth,Stream Mic=Stream
# Studio B:  MIC_INPUTS=Stream Mic=Stream,Piano=Piano,Tascam Mix=Tascam
MIC_INPUTS=Booth Mic=Booth,Stream Mic=Stream

# OBS lists scenes bottom-to-top. "reverse" matches the order in the OBS window.
# If the dashboard shows them upside down, change this to normal.
SCENE_ORDER=reverse

# Go-live destinations, as  Name|server|stream key  separated by commas. Keys stay on this Mac.
# Leave empty to hide the Stream controls. Only one destination can be live at a time.
# Twitch:   Twitch|rtmp://live.twitch.tv/app|live_xxxxxxxx
# YouTube:  YouTube|rtmp://a.rtmp.youtube.com/live2|xxxx-xxxx-xxxx-xxxx
# Kick:     Kick|<server URL from Kick dashboard>|sk_xxxxxxxx
STREAM_TARGETS=
